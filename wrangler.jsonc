{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "photo-blog",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [],
  "vars": {
    "NEXT_PUBLIC_CLOUDFLARE_R2_ACCOUNT_ID": "d23fcdf5428d0da372717832ea6c7252",
    "NEXT_PUBLIC_CLOUDFLARE_R2_BUCKET": "photos",
    "NEXT_PUBLIC_CLOUDFLARE_R2_PUBLIC_DOMAIN": "p.reda.fyi",
    "NEXT_PUBLIC_SITE_DOMAIN": "by.reda.fyi",
    "NEXT_PUBLIC_SITE_TITLE": "Shot by Reda",
    "NEXT_PUBLIC_GRID_ASPECT_RATIO": "1.5",
    "NEXT_PUBLIC_SHOW_LARGE_THUMBNAILS": "1",
    "NEXT_PUBLIC_HIDE_REPO_LINK": "1"
  }
}
